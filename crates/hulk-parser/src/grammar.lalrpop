// HULK grammar — complete (A.2–A.8).
//
// Processed by build.rs into src/grammar.rs.
// Uses an external lexer from hulk-lexer (logos-based).

use hulk_ast::*;
use hulk_lexer::{Token, LexError, parse_number, parse_string};
use crate::{TypeMemberKind, TopDecl};

grammar<'input>(input: &'input str);

extern {
    type Location = usize;
    type Error = LexError;

    enum Token {
        // Keywords
        "let"        => Token::Let,
        "in"         => Token::In,
        "if"         => Token::If,
        "elif"       => Token::Elif,
        "else"       => Token::Else,
        "while"      => Token::While,
        "for"        => Token::For,
        "function"   => Token::Function,
        "type"       => Token::Type,
        "inherits"   => Token::Inherits,
        "interface"  => Token::Interface,
        "implements" => Token::Implements,
        "extends"    => Token::Extends,
        "new"        => Token::New,
        "is"         => Token::Is,
        "as"         => Token::As,
        "true"       => Token::True,
        "false"      => Token::False,

        // Operators
        "+"  => Token::Plus,
        "-"  => Token::Minus,
        "**" => Token::StarStar,
        "*"  => Token::Star,
        "/"  => Token::Slash,
        "^"  => Token::Caret,
        "%"  => Token::Percent,
        "@@" => Token::AtAt,
        "@"  => Token::At,
        "==" => Token::EqEq,
        "!=" => Token::BangEq,
        "<=" => Token::LtEq,
        "<"  => Token::Lt,
        ">=" => Token::GtEq,
        ">"  => Token::Gt,
        "&"  => Token::Amp,
        "|"  => Token::Pipe,
        "!"  => Token::Bang,
        ":=" => Token::ColonEq,
        "=>" => Token::FatArrow,
        "="  => Token::Eq,

        // Punctuation
        "(" => Token::LParen,
        ")" => Token::RParen,
        "{" => Token::LBrace,
        "}" => Token::RBrace,
        ";" => Token::Semi,
        "," => Token::Comma,
        "." => Token::Dot,
        ":" => Token::Colon,
        "[" => Token::LBracket,
        "]" => Token::RBracket,

        // Literals & Ident
        NumLit    => Token::Number,
        StringLit => Token::StringLit,
        IdentTok  => Token::Ident,
    }
}

// =====================================================================
// Utility macros
// =====================================================================

Comma<T>: Vec<T> = {
    <mut v:(<T> ",")*> <e:T?> => match e {
        None => v,
        Some(e) => { v.push(e); v }
    }
};

Comma1<T>: Vec<T> = {
    <mut v:(<T> ",")*> <e:T> => { v.push(e); v }
};

// Extract the source slice for an identifier token.
IdentStr: &'input str = <lo:@L> IdentTok <hi:@R> => &input[lo..hi];

// Type reference: either a simple name or a parameterized type (extension).
// Examples: `Number`, `List[T]`, `Map[String, List[Number]]`.
TypeRef: TypeRef = {
    // Typed-iterable `T*` (A.11.2): an iterable whose elements have type `T`.
    <inner:TypeRef> "*" => TypeRef::Iterable(Box::new(inner)),
    <name:IdentStr> "[" <args:Comma1<TypeRef>> "]" => TypeRef::Generic(name.to_string(), args),
    <name:IdentStr> => TypeRef::Simple(name.to_string()),
};

// Generic parameter list (declaration): `[T]`, `[T, U]`.
GenericParams: Vec<String> = {
    "[" <params:Comma1<IdentStr>> "]" => params.into_iter().map(|s| s.to_string()).collect(),
};

// Generic argument list (use site): `[Number]`, `[String, Point]`.
GenericArgs: Vec<TypeRef> = {
    "[" <args:Comma1<TypeRef>> "]" => args,
};

// =====================================================================
// Top-level: Program
// =====================================================================

pub Program: Program = {
    // Declarations may appear in any order (A.3); partition them afterwards.
    <decls:TopDecl*> <entry:EntryExpr> => {
        let mut interfaces = Vec::new();
        let mut types = Vec::new();
        let mut functions = Vec::new();
        for decl in decls {
            match decl {
                TopDecl::Interface(i) => interfaces.push(i),
                TopDecl::Type(t) => types.push(t),
                TopDecl::Function(f) => functions.push(f),
            }
        }
        Program { interfaces, types, functions, entry }
    },
};

// The program's entry point. HULK is expression-based, so the top level is an
// implicit expression block (A.2.4): zero or more `;`-terminated statements
// followed by a final expression, with an optional trailing `;`. A lone
// expression is returned as-is, so single-expression programs parse to byte-for-
// byte identical ASTs; a sequence desugars to a `Block` whose value is the last
// expression — exactly like a `{ ... }` block. This makes the common
// `print(1); print(2);` valid at the top level without wrapping it in braces.
// The trailing expression is mandatory, so a program always ends in an
// expression (and an entry is never empty), matching the spec.
EntryExpr: Expr = {
    <lo:@L> <mut stmts:(<Expr> ";")*> <last:Expr> ";"? <hi:@R> => {
        if stmts.is_empty() {
            last
        } else {
            stmts.push(last);
            Expr { span: Span::new(lo, hi), kind: ExprKind::Block(stmts) }
        }
    },
};

TopDecl: TopDecl = {
    <i:InterfaceDecl> => TopDecl::Interface(i),
    <t:TypeDecl> => TopDecl::Type(t),
    <f:FunctionDecl> => TopDecl::Function(f),
};

// =====================================================================
// Interface declarations (extension)
// =====================================================================

InterfaceDecl: InterfaceDecl = {
    <lo:@L> "interface" <name:IdentStr> <gp:GenericParams?>
        <ext:("extends" <Comma1<TypeRef>>)?>
        "{" <methods:InterfaceMethodSig*> "}" <hi:@R> => {
        InterfaceDecl {
            name: name.to_string(),
            generic_params: gp.unwrap_or_default(),
            extends: ext.unwrap_or_default(),
            methods,
            span: Span::new(lo, hi),
        }
    },
};

InterfaceMethodSig: InterfaceMethodSig = {
    // name(params)[: RetTy];
    <lo:@L> <name:IdentStr> "(" <params:Comma<TypeParam>> ")"
        <ret:(":" <TypeRef>)?> ";" <hi:@R> => {
        InterfaceMethodSig {
            name: name.to_string(),
            params,
            return_ty: ret,
            span: Span::new(lo, hi),
        }
    },
};

// =====================================================================
// Type declarations (A.7)
// =====================================================================

TypeDecl: TypeDecl = {
    // type Name[T,U](params) [inherits Parent(args)] [implements I1, I2] { body }
    <lo:@L> "type" <name:IdentStr> <gp:GenericParams?>
        "(" <params:Comma<TypeParam>> ")"
        <parent:InheritsClause?>
        <impls:ImplementsClause?>
        "{" <body:TypeBody> "}" <hi:@R> => {
        TypeDecl {
            name: name.to_string(),
            generic_params: gp.unwrap_or_default(),
            type_params: params,
            parent,
            implements: impls.unwrap_or_default(),
            attributes: body.0,
            methods: body.1,
            span: Span::new(lo, hi),
        }
    },
    // type Name[T,U] [inherits Parent(args)] [implements I1, I2] { body }  (no ctor params)
    <lo:@L> "type" <name:IdentStr> <gp:GenericParams?>
        <parent:InheritsClause?>
        <impls:ImplementsClause?>
        "{" <body:TypeBody> "}" <hi:@R> => {
        TypeDecl {
            name: name.to_string(),
            generic_params: gp.unwrap_or_default(),
            type_params: vec![],
            parent,
            implements: impls.unwrap_or_default(),
            attributes: body.0,
            methods: body.1,
            span: Span::new(lo, hi),
        }
    },
};

// Implements clause: a comma-separated list of interface references.
ImplementsClause: Vec<TypeRef> = {
    "implements" <ifaces:Comma1<TypeRef>> => ifaces,
};

TypeParam: Param = {
    <lo:@L> <name:IdentStr> <ty:(":" <TypeRef>)?> <hi:@R> => {
        Param { name: name.to_string(), ty, span: Span::new(lo, hi) }
    },
};

InheritsClause: ParentSpec = {
    <lo:@L> "inherits" <name:IdentStr> "(" <args:Comma<Expr>> ")" <hi:@R> => {
        ParentSpec { name: name.to_string(), args: Some(args), span: Span::new(lo, hi) }
    },
    <lo:@L> "inherits" <name:IdentStr> <hi:@R> => {
        ParentSpec { name: name.to_string(), args: None, span: Span::new(lo, hi) }
    },
};

TypeBody: (Vec<AttrDecl>, Vec<MethodDecl>) = {
    <members:TypeMember*> => {
        let mut attrs = Vec::new();
        let mut methods = Vec::new();
        for m in members {
            match m {
                TypeMemberKind::Attr(a) => attrs.push(a),
                TypeMemberKind::Method(m) => methods.push(m),
            }
        }
        (attrs, methods)
    }
};

TypeMember: TypeMemberKind = {
    <a:AttrDecl> => TypeMemberKind::Attr(a),
    <m:MethodDecl> => TypeMemberKind::Method(m),
};

AttrDecl: AttrDecl = {
    <lo:@L> <name:IdentStr> <ty:(":" <TypeRef>)?> "=" <init:Expr> ";" <hi:@R> => {
        AttrDecl {
            name: name.to_string(),
            ty,
            init,
            span: Span::new(lo, hi),
        }
    },
};

MethodDecl: MethodDecl = {
    // Inline: name(params)[: RetTy] => expr;
    <lo:@L> <name:IdentStr> "(" <params:Comma<TypeParam>> ")"
        <ret:(":" <TypeRef>)?> "=>" <body:Expr> ";" <hi:@R> => {
        MethodDecl {
            name: name.to_string(),
            params,
            return_ty: ret,
            body,
            span: Span::new(lo, hi),
        }
    },
    // Block: name(params)[: RetTy] { body }
    <lo:@L> <name:IdentStr> "(" <params:Comma<TypeParam>> ")"
        <ret:(":" <TypeRef>)?> <body:BlockExpr> <hi:@R> => {
        MethodDecl {
            name: name.to_string(),
            params,
            return_ty: ret,
            body,
            span: Span::new(lo, hi),
        }
    },
};

// =====================================================================
// Function declarations (A.3)
// =====================================================================

FunctionDecl: FunctionDecl = {
    // Inline: function name[T,U](params)[: RetTy] => expr;
    <lo:@L> "function" <name:IdentStr> <gp:GenericParams?>
        "(" <params:Comma<FuncParam>> ")"
        <ret:(":" <TypeRef>)?> "=>" <body:Expr> ";" <hi:@R> => {
        FunctionDecl {
            name: name.to_string(),
            generic_params: gp.unwrap_or_default(),
            params,
            return_ty: ret,
            body,
            span: Span::new(lo, hi),
        }
    },
    // Block: function name[T,U](params)[: RetTy] { body }
    <lo:@L> "function" <name:IdentStr> <gp:GenericParams?>
        "(" <params:Comma<FuncParam>> ")"
        <ret:(":" <TypeRef>)?> <body:BlockExpr> <hi:@R> => {
        FunctionDecl {
            name: name.to_string(),
            generic_params: gp.unwrap_or_default(),
            params,
            return_ty: ret,
            body,
            span: Span::new(lo, hi),
        }
    },
};

FuncParam: Param = {
    <lo:@L> <name:IdentStr> <ty:(":" <TypeRef>)?> <hi:@R> => {
        Param { name: name.to_string(), ty, span: Span::new(lo, hi) }
    },
};

// =====================================================================
// Expressions — precedence climbing
// =====================================================================

// Level 0: top-level expression.
//
// HULK treats *everything* as an expression (A.1/A.5): `if`/`while`/`for`/`let`
// can appear anywhere a value is expected, including as a binary operand
// (`total + if (c) 1 else 0`, A.13). Encoding that naively makes the grammar
// ambiguous (does the trailing `+ z` belong to the `if`'s `else` branch or to
// the outer sum?). We resolve it the same way `if`/`else` dangling is resolved:
// split expressions into "closed" and "open".
//
//   * A CLOSED expression is a pure binary/assignment tree; it never ends in a
//     bare control-flow / `let` construct.
//   * An OPEN expression is a binary chain whose RIGHTMOST operand is a bare
//     control-flow / `let` (`CtrlAtom`).
//
// Crucially, every level of the open chain (`*C`) takes the CLOSED level as its
// left operand, so the open levels are never left-recursive on themselves. That
// means an open expression can only ever be a tail: the trailing operator is
// forced to bind into the control-flow body, which is exactly HULK's greedy
// "the branch extends as far right as possible" semantics — and it keeps the
// grammar LALR(1) (the divergence is driven by the `if`/`while`/`for`/`let`
// keywords, whose FIRST set is disjoint from any closed atom).
pub Expr: Expr = {
    ClosedExpr,
    OpenExpr,
};

// Closed: assignment or a pure binary expression (no bare control-flow tail).
ClosedExpr: Expr = {
    AssignExpr,
    OrExpr,
};

// Open: a binary chain whose rightmost operand is a bare control-flow / `let`.
OpenExpr: Expr = {
    OrExprC,
};

// The bare control-flow / `let` constructs, reachable only at the open tail.
CtrlAtom: Expr = {
    IfExpr,
    WhileExpr,
    ForExpr,
    LetExpr,
};

// Restricted form used ONLY for `let` binding initializers (`let x = <init>`).
// It admits control flow and binary expressions but not a bare `let`, so a
// nested `let` as an initializer still needs parens and the `in` keyword pairs
// unambiguously with its `let`.
ControlOrBinary: Expr = {
    IfExpr,
    WhileExpr,
    ForExpr,
    AssignExpr,
    OrExpr,
};

// ---- Let expression (A.4) ----
LetExpr: Expr = {
    <lo:@L> "let" <bindings:Comma1<LetBinding>> "in" <body:Expr> <hi:@R> => {
        // Desugar multi-let: fold right to produce nested Let nodes
        bindings.into_iter().rev().fold(body, |acc, (name, ty, init, bspan)| {
            Expr {
                span: Span::new(bspan.lo as usize, hi),
                kind: ExprKind::Let(name, ty, Box::new(init), Box::new(acc)),
            }
        })
    },
};

LetBinding: (String, Option<TypeRef>, Expr, Span) = {
    <lo:@L> <name:IdentStr> <ty:(":" <TypeRef>)?> "=" <init:ControlOrBinary> <hi:@R> => {
        (name.to_string(), ty, init, Span::new(lo, hi))
    },
};

// ---- Assignment (A.4.6) ----
AssignExpr: Expr = {
    // Variable assignment: x := expr
    <lo:@L> <name:IdentStr> ":=" <val:Expr> <hi:@R> => {
        Expr {
            span: Span::new(lo, hi),
            kind: ExprKind::Assign(name.to_string(), Box::new(val)),
        }
    },
    // Field assignment: expr.field := expr
    <lo:@L> <obj:PostfixExpr> "." <field:IdentStr> ":=" <val:Expr> <hi:@R> => {
        Expr {
            span: Span::new(lo, hi),
            kind: ExprKind::AssignField(Box::new(obj), field.to_string(), Box::new(val)),
        }
    },
};

// Level 1: logical or
OrExpr: Expr = {
    <lo:@L> <lhs:OrExpr> "|" <rhs:AndExpr> <hi:@R> => {
        Expr {
            span: Span::new(lo, hi),
            kind: ExprKind::BinOp(BinOp::Or, Box::new(lhs), Box::new(rhs)),
        }
    },
    AndExpr,
};

// Level 2: logical and
AndExpr: Expr = {
    <lo:@L> <lhs:AndExpr> "&" <rhs:NotExpr> <hi:@R> => {
        Expr {
            span: Span::new(lo, hi),
            kind: ExprKind::BinOp(BinOp::And, Box::new(lhs), Box::new(rhs)),
        }
    },
    NotExpr,
};

// Level 3: logical not (prefix)
NotExpr: Expr = {
    <lo:@L> "!" <e:NotExpr> <hi:@R> => {
        Expr {
            span: Span::new(lo, hi),
            kind: ExprKind::UnOp(UnOp::Not, Box::new(e)),
        }
    },
    CompareExpr,
};

// Level 4: comparison (non-associative)
CompareExpr: Expr = {
    <lo:@L> <lhs:TypeOpExpr> "==" <rhs:TypeOpExpr> <hi:@R> => {
        Expr { span: Span::new(lo, hi), kind: ExprKind::BinOp(BinOp::Eq, Box::new(lhs), Box::new(rhs)) }
    },
    <lo:@L> <lhs:TypeOpExpr> "!=" <rhs:TypeOpExpr> <hi:@R> => {
        Expr { span: Span::new(lo, hi), kind: ExprKind::BinOp(BinOp::Ne, Box::new(lhs), Box::new(rhs)) }
    },
    <lo:@L> <lhs:TypeOpExpr> "<" <rhs:TypeOpExpr> <hi:@R> => {
        Expr { span: Span::new(lo, hi), kind: ExprKind::BinOp(BinOp::Lt, Box::new(lhs), Box::new(rhs)) }
    },
    <lo:@L> <lhs:TypeOpExpr> "<=" <rhs:TypeOpExpr> <hi:@R> => {
        Expr { span: Span::new(lo, hi), kind: ExprKind::BinOp(BinOp::Le, Box::new(lhs), Box::new(rhs)) }
    },
    <lo:@L> <lhs:TypeOpExpr> ">" <rhs:TypeOpExpr> <hi:@R> => {
        Expr { span: Span::new(lo, hi), kind: ExprKind::BinOp(BinOp::Gt, Box::new(lhs), Box::new(rhs)) }
    },
    <lo:@L> <lhs:TypeOpExpr> ">=" <rhs:TypeOpExpr> <hi:@R> => {
        Expr { span: Span::new(lo, hi), kind: ExprKind::BinOp(BinOp::Ge, Box::new(lhs), Box::new(rhs)) }
    },
    TypeOpExpr,
};

// Level 5: type operations (is, as)
TypeOpExpr: Expr = {
    <lo:@L> <e:ConcatExpr> "is" <ty:TypeRef> <hi:@R> => {
        Expr { span: Span::new(lo, hi), kind: ExprKind::Is(Box::new(e), ty) }
    },
    <lo:@L> <e:ConcatExpr> "as" <ty:TypeRef> <hi:@R> => {
        Expr { span: Span::new(lo, hi), kind: ExprKind::As(Box::new(e), ty) }
    },
    ConcatExpr,
};

// Level 6: string concatenation (right-associative)
ConcatExpr: Expr = {
    <lo:@L> <lhs:AddExpr> "@" <rhs:ConcatExpr> <hi:@R> => {
        Expr { span: Span::new(lo, hi), kind: ExprKind::BinOp(BinOp::Concat, Box::new(lhs), Box::new(rhs)) }
    },
    <lo:@L> <lhs:AddExpr> "@@" <rhs:ConcatExpr> <hi:@R> => {
        Expr { span: Span::new(lo, hi), kind: ExprKind::BinOp(BinOp::ConcatWs, Box::new(lhs), Box::new(rhs)) }
    },
    AddExpr,
};

// Level 7: addition / subtraction (left-associative)
AddExpr: Expr = {
    <lo:@L> <lhs:AddExpr> "+" <rhs:MulExpr> <hi:@R> => {
        Expr { span: Span::new(lo, hi), kind: ExprKind::BinOp(BinOp::Add, Box::new(lhs), Box::new(rhs)) }
    },
    <lo:@L> <lhs:AddExpr> "-" <rhs:MulExpr> <hi:@R> => {
        Expr { span: Span::new(lo, hi), kind: ExprKind::BinOp(BinOp::Sub, Box::new(lhs), Box::new(rhs)) }
    },
    MulExpr,
};

// Level 8: multiplication / division / modulo (left-associative)
MulExpr: Expr = {
    <lo:@L> <lhs:MulExpr> "*" <rhs:UnaryExpr> <hi:@R> => {
        Expr { span: Span::new(lo, hi), kind: ExprKind::BinOp(BinOp::Mul, Box::new(lhs), Box::new(rhs)) }
    },
    <lo:@L> <lhs:MulExpr> "/" <rhs:UnaryExpr> <hi:@R> => {
        Expr { span: Span::new(lo, hi), kind: ExprKind::BinOp(BinOp::Div, Box::new(lhs), Box::new(rhs)) }
    },
    <lo:@L> <lhs:MulExpr> "%" <rhs:UnaryExpr> <hi:@R> => {
        Expr { span: Span::new(lo, hi), kind: ExprKind::BinOp(BinOp::Mod, Box::new(lhs), Box::new(rhs)) }
    },
    UnaryExpr,
};

// Level 9: unary prefix (negation). Binds looser than power so that `-2 ^ 2`
// parses as `-(2 ^ 2)` (the mathematical convention), while still binding
// tighter than `*`/`/`/`%` so that `2 * -3` is `2 * (-3)`.
UnaryExpr: Expr = {
    <lo:@L> "-" <e:UnaryExpr> <hi:@R> => {
        Expr { span: Span::new(lo, hi), kind: ExprKind::UnOp(UnOp::Neg, Box::new(e)) }
    },
    PowExpr,
};

// Level 10: power (right-associative). Both `^` and `**` are accepted per spec.
// The base is a postfix expression; the exponent is a unary expression, so a
// negated exponent (`2 ^ -1`) and right chaining (`2 ^ 3 ^ 4`) both parse.
PowExpr: Expr = {
    <lo:@L> <base:PostfixExpr> "^" <exp:UnaryExpr> <hi:@R> => {
        Expr { span: Span::new(lo, hi), kind: ExprKind::BinOp(BinOp::Pow, Box::new(base), Box::new(exp)) }
    },
    <lo:@L> <base:PostfixExpr> "**" <exp:UnaryExpr> <hi:@R> => {
        Expr { span: Span::new(lo, hi), kind: ExprKind::BinOp(BinOp::Pow, Box::new(base), Box::new(exp)) }
    },
    PostfixExpr,
};

// Level 11: postfix (member access, method call)
PostfixExpr: Expr = {
    // Method call: expr.name(args)
    <lo:@L> <obj:PostfixExpr> "." <name:IdentStr> "(" <args:Comma<Expr>> ")" <hi:@R> => {
        Expr {
            span: Span::new(lo, hi),
            kind: ExprKind::MethodCall(Box::new(obj), name.to_string(), args),
        }
    },
    // Field access: expr.name
    <lo:@L> <obj:PostfixExpr> "." <name:IdentStr> <hi:@R> => {
        Expr {
            span: Span::new(lo, hi),
            kind: ExprKind::GetField(Box::new(obj), name.to_string()),
        }
    },
    AtomExpr,
};

// Level 12: atoms (self-delimiting expressions)
AtomExpr: Expr = {
    // Number literal
    <lo:@L> NumLit <hi:@R> => {
        Expr {
            span: Span::new(lo, hi),
            kind: ExprKind::Number(parse_number(&input[lo..hi])),
        }
    },
    // String literal
    <lo:@L> StringLit <hi:@R> => {
        Expr {
            span: Span::new(lo, hi),
            kind: ExprKind::String(parse_string(&input[lo..hi])),
        }
    },
    // Boolean literals
    <lo:@L> "true" <hi:@R> => {
        Expr { span: Span::new(lo, hi), kind: ExprKind::Bool(true) }
    },
    <lo:@L> "false" <hi:@R> => {
        Expr { span: Span::new(lo, hi), kind: ExprKind::Bool(false) }
    },
    // Parenthesized expression (allows control flow inside binary ops)
    "(" <Expr> ")",
    // Block expression
    BlockExpr,
    // New expression
    NewExpr,
    // Function call, base(), self, or plain identifier
    CallOrIdentExpr,
};

// Function call, base(), self, or plain identifier
CallOrIdentExpr: Expr = {
    // Call: name(args) — also handles base(args)
    <lo:@L> <name:IdentStr> "(" <args:Comma<Expr>> ")" <hi:@R> => {
        let span = Span::new(lo, hi);
        if name == "base" {
            Expr { span, kind: ExprKind::Base(args) }
        } else {
            Expr { span, kind: ExprKind::Call(name.to_string(), args) }
        }
    },
    // Identifier or self
    <lo:@L> <name:IdentStr> <hi:@R> => {
        let span = Span::new(lo, hi);
        if name == "self" {
            Expr { span, kind: ExprKind::SelfExpr }
        } else {
            Expr { span, kind: ExprKind::Ident(name.to_string()) }
        }
    },
};

// =====================================================================
// Open-tail expression chain
//
// Mirrors the closed precedence levels above, but every binary level takes the
// CLOSED level as its left operand and bottoms out at `CtrlAtom`, so each `*C`
// nonterminal always ends in a bare control-flow / `let`. See `Expr` for why
// this is unambiguous and LALR(1)-friendly. The AST built is identical to the
// closed levels — only the right-operand spine differs.
// =====================================================================

OrExprC: Expr = {
    <lo:@L> <lhs:OrExpr> "|" <rhs:AndExprC> <hi:@R> =>
        Expr { span: Span::new(lo, hi), kind: ExprKind::BinOp(BinOp::Or, Box::new(lhs), Box::new(rhs)) },
    AndExprC,
};

AndExprC: Expr = {
    <lo:@L> <lhs:AndExpr> "&" <rhs:NotExprC> <hi:@R> =>
        Expr { span: Span::new(lo, hi), kind: ExprKind::BinOp(BinOp::And, Box::new(lhs), Box::new(rhs)) },
    NotExprC,
};

NotExprC: Expr = {
    <lo:@L> "!" <e:NotExprC> <hi:@R> =>
        Expr { span: Span::new(lo, hi), kind: ExprKind::UnOp(UnOp::Not, Box::new(e)) },
    CompareExprC,
};

CompareExprC: Expr = {
    <lo:@L> <lhs:TypeOpExpr> "==" <rhs:TypeOpExprC> <hi:@R> =>
        Expr { span: Span::new(lo, hi), kind: ExprKind::BinOp(BinOp::Eq, Box::new(lhs), Box::new(rhs)) },
    <lo:@L> <lhs:TypeOpExpr> "!=" <rhs:TypeOpExprC> <hi:@R> =>
        Expr { span: Span::new(lo, hi), kind: ExprKind::BinOp(BinOp::Ne, Box::new(lhs), Box::new(rhs)) },
    <lo:@L> <lhs:TypeOpExpr> "<" <rhs:TypeOpExprC> <hi:@R> =>
        Expr { span: Span::new(lo, hi), kind: ExprKind::BinOp(BinOp::Lt, Box::new(lhs), Box::new(rhs)) },
    <lo:@L> <lhs:TypeOpExpr> "<=" <rhs:TypeOpExprC> <hi:@R> =>
        Expr { span: Span::new(lo, hi), kind: ExprKind::BinOp(BinOp::Le, Box::new(lhs), Box::new(rhs)) },
    <lo:@L> <lhs:TypeOpExpr> ">" <rhs:TypeOpExprC> <hi:@R> =>
        Expr { span: Span::new(lo, hi), kind: ExprKind::BinOp(BinOp::Gt, Box::new(lhs), Box::new(rhs)) },
    <lo:@L> <lhs:TypeOpExpr> ">=" <rhs:TypeOpExprC> <hi:@R> =>
        Expr { span: Span::new(lo, hi), kind: ExprKind::BinOp(BinOp::Ge, Box::new(lhs), Box::new(rhs)) },
    TypeOpExprC,
};

// `is`/`as` take a type on the right, never an expression, so the open variant
// just descends to the concat level.
TypeOpExprC: Expr = {
    ConcatExprC,
};

ConcatExprC: Expr = {
    <lo:@L> <lhs:AddExpr> "@" <rhs:ConcatExprC> <hi:@R> =>
        Expr { span: Span::new(lo, hi), kind: ExprKind::BinOp(BinOp::Concat, Box::new(lhs), Box::new(rhs)) },
    <lo:@L> <lhs:AddExpr> "@@" <rhs:ConcatExprC> <hi:@R> =>
        Expr { span: Span::new(lo, hi), kind: ExprKind::BinOp(BinOp::ConcatWs, Box::new(lhs), Box::new(rhs)) },
    AddExprC,
};

AddExprC: Expr = {
    <lo:@L> <lhs:AddExpr> "+" <rhs:MulExprC> <hi:@R> =>
        Expr { span: Span::new(lo, hi), kind: ExprKind::BinOp(BinOp::Add, Box::new(lhs), Box::new(rhs)) },
    <lo:@L> <lhs:AddExpr> "-" <rhs:MulExprC> <hi:@R> =>
        Expr { span: Span::new(lo, hi), kind: ExprKind::BinOp(BinOp::Sub, Box::new(lhs), Box::new(rhs)) },
    MulExprC,
};

MulExprC: Expr = {
    <lo:@L> <lhs:MulExpr> "*" <rhs:UnaryExprC> <hi:@R> =>
        Expr { span: Span::new(lo, hi), kind: ExprKind::BinOp(BinOp::Mul, Box::new(lhs), Box::new(rhs)) },
    <lo:@L> <lhs:MulExpr> "/" <rhs:UnaryExprC> <hi:@R> =>
        Expr { span: Span::new(lo, hi), kind: ExprKind::BinOp(BinOp::Div, Box::new(lhs), Box::new(rhs)) },
    <lo:@L> <lhs:MulExpr> "%" <rhs:UnaryExprC> <hi:@R> =>
        Expr { span: Span::new(lo, hi), kind: ExprKind::BinOp(BinOp::Mod, Box::new(lhs), Box::new(rhs)) },
    UnaryExprC,
};

UnaryExprC: Expr = {
    <lo:@L> "-" <e:UnaryExprC> <hi:@R> =>
        Expr { span: Span::new(lo, hi), kind: ExprKind::UnOp(UnOp::Neg, Box::new(e)) },
    PowExprC,
};

// Base case of the open chain: the bare control-flow / `let` atom (or a power
// whose exponent is open). There is intentionally no bare-`PostfixExpr` case —
// closed operands always flow through the closed chain.
PowExprC: Expr = {
    <lo:@L> <base:PostfixExpr> "^" <exp:UnaryExprC> <hi:@R> =>
        Expr { span: Span::new(lo, hi), kind: ExprKind::BinOp(BinOp::Pow, Box::new(base), Box::new(exp)) },
    <lo:@L> <base:PostfixExpr> "**" <exp:UnaryExprC> <hi:@R> =>
        Expr { span: Span::new(lo, hi), kind: ExprKind::BinOp(BinOp::Pow, Box::new(base), Box::new(exp)) },
    CtrlAtom,
};

// =====================================================================
// Compound expressions (control flow)
// =====================================================================

// Block: { expr; expr; ... expr? }
BlockExpr: Expr = {
    <lo:@L> "{" <mut stmts:(<Expr> ";")*> <last:Expr?> "}" <hi:@R> => {
        if let Some(e) = last {
            stmts.push(e);
        }
        Expr {
            span: Span::new(lo, hi),
            kind: ExprKind::Block(stmts),
        }
    },
};

// If / elif / else (A.5)
IfExpr: Expr = {
    <lo:@L> "if" "(" <cond:Expr> ")" <then:Expr>
        <elifs:("elif" "(" <Expr> ")" <Expr>)*>
        "else" <else_:Expr> <hi:@R> => {
        Expr {
            span: Span::new(lo, hi),
            kind: ExprKind::If(
                Box::new(cond),
                Box::new(then),
                elifs,
                Box::new(else_),
            ),
        }
    },
};

// While loop (A.6.1)
WhileExpr: Expr = {
    <lo:@L> "while" "(" <cond:Expr> ")" <body:Expr> <hi:@R> => {
        Expr {
            span: Span::new(lo, hi),
            kind: ExprKind::While(Box::new(cond), Box::new(body)),
        }
    },
};

// For loop (A.6.2)
ForExpr: Expr = {
    <lo:@L> "for" "(" <name:IdentStr> "in" <iter:Expr> ")" <body:Expr> <hi:@R> => {
        Expr {
            span: Span::new(lo, hi),
            kind: ExprKind::For(name.to_string(), Box::new(iter), Box::new(body)),
        }
    },
};

// New expression (A.7.2 + generics): `new TypeName[T1, T2](args)`.
NewExpr: Expr = {
    <lo:@L> "new" <name:IdentStr> <ga:GenericArgs?> "(" <args:Comma<Expr>> ")" <hi:@R> => {
        Expr {
            span: Span::new(lo, hi),
            kind: ExprKind::New(name.to_string(), ga.unwrap_or_default(), args),
        }
    },
};
